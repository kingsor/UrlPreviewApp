<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UrlPreviewApp.Client\UrlPreviewApp.Client.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.13" />
  </ItemGroup>

  <!-- UrlPreviewParser is used only on the server: AngleSharp never reaches the WebAssembly bundle. -->
  <ItemGroup Condition="'$(UseLocalUrlPreviewParser)' == 'true'">
    <ProjectReference Include="$(UrlPreviewParserProject)" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalUrlPreviewParser)' != 'true'">
    <PackageReference Include="UrlPreviewParser" Version="$(UrlPreviewParserVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UrlPreviewApp.Tests" />
  </ItemGroup>

</Project>

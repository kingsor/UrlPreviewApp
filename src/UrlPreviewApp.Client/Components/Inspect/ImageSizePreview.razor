@inject BrowserInterop Browser

@if (!string.IsNullOrWhiteSpace(Url))
{
    <MudStack Spacing="2">
        <div class="eyebrow">@Label</div>
        <MudPaper Outlined Class="@(IsFavicon ? "image-frame image-frame--favicon" : "image-frame")">
            @if (_failed)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">Failed to load</MudText>
            }
            else
            {
                <img src="@Url" alt="@Label" @onerror="() => _failed = true" />
            }
        </MudPaper>
        <MudText Typo="Typo.body2" Class="text-soft">
            @if (_failed)
            {
                <MudText Inline Typo="Typo.body2" Color="Color.Error">• Image could not be loaded</MudText>
            }
            else if (_size is null)
            {
                <span>• Loading...</span>
            }
            else
            {
                <MudText Inline Typo="Typo.body2" Color="SizeColor">• @_size.Width × @_size.Height</MudText>
                @if (RecommendedWidth > 0)
                {
                    <MudText Inline Typo="Typo.body2" Color="Color.Secondary"> (recommended: @RecommendedWidth×@RecommendedHeight)</MudText>
                }
            }
        </MudText>
    </MudStack>
}

@code {
    private string? _measuredUrl;
    private ImageSize? _size;
    private bool _failed;

    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string? Url { get; set; }

    [Parameter]
    public int RecommendedWidth { get; set; }

    [Parameter]
    public int RecommendedHeight { get; set; }

    [Parameter]
    public bool IsFavicon { get; set; }

    /// <summary>Green when exact, yellow when the aspect ratio matches within 2%, red otherwise.</summary>
    private Color SizeColor
    {
        get
        {
            if (_size is null || RecommendedWidth <= 0 || RecommendedHeight <= 0 || _size.Height == 0)
                return Color.Inherit;

            if (_size.Width == RecommendedWidth && _size.Height == RecommendedHeight)
                return Color.Success;

            var ratio = (double)_size.Width / _size.Height;
            var recommendedRatio = (double)RecommendedWidth / RecommendedHeight;
            return Math.Abs(ratio - recommendedRatio) / recommendedRatio <= 0.02 ? Color.Warning : Color.Error;
        }
    }

    protected override void OnParametersSet()
    {
        if (Url != _measuredUrl)
        {
            _size = null;
            _failed = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Url is null || Url == _measuredUrl)
            return;

        var url = _measuredUrl = Url;
        var size = await Browser.GetImageSizeAsync(url);
        if (url != Url)
            return;

        _size = size;
        _failed = size is null;
        StateHasChanged();
    }
}

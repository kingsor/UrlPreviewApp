<div class="field">
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="field__label">@Label</MudText>
    <MudText Typo="Typo.body2" Class="field__value" HtmlTag="div">
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else if (!string.IsNullOrWhiteSpace(Value))
        {
            @Value
        }
        else
        {
            <NotSet />
        }
    </MudText>
</div>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}

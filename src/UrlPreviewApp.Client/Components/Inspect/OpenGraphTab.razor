<MudStack Spacing="6" Class="narrow">
    <SectionCard Title="Open Graph">
        <MetadataField Label="Title">
            <TextWithCount Text="@Metadata.OgTitle" Max="MetadataLimits.OgTitleMaxChars" />
        </MetadataField>
        <MetadataField Label="Description">
            <TextWithCount Text="@Metadata.OgDescription" Max="MetadataLimits.OgDescriptionMaxChars" />
        </MetadataField>
        <MetadataField Label="Image">
            <ImageValue Url="@Metadata.OgImage" Alt="Open Graph image" />
        </MetadataField>
        <MetadataField Label="Type" Value="@Metadata.OgType" />
        <MetadataField Label="URL">
            <LinkValue Url="@Metadata.OgUrl" />
        </MetadataField>
        <MetadataField Label="Site Name" Value="@Metadata.OgSiteName" />
        <MetadataField Label="Locale" Value="@Metadata.OgLocale" />
    </SectionCard>
</MudStack>

@code {
    [Parameter, EditorRequired]
    public PageMetadata Metadata { get; set; } = default!;
}

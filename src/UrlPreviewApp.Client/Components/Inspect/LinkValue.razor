@if (string.IsNullOrWhiteSpace(Url))
{
    <NotSet />
}
else if (UrlNormalizer.IsHttpUrl(Url))
{
    <span class="link-value @(Italic ? "is-italic" : null)">
        <MudLink Href="@Url" Target="_blank" rel="noopener noreferrer" Color="Color.Inherit">@Url</MudLink>
        <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Color="Color.Secondary" Style="font-size: 0.875rem" />
    </span>
}
else
{
    @* Not an http(s) URL: shown as text, never as a clickable link. *@
    <span class="break-all">@Url</span>
}

@code {
    [Parameter]
    public string? Url { get; set; }

    [Parameter]
    public bool Italic { get; set; }
}

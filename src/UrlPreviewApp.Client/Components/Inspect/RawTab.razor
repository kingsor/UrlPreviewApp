@using System.Text.Json

<MudCard Outlined>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6" HtmlTag="h3">Raw Metadata</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <CopyButton Text="@(_format == "json" ? _json : _html)" Label="@(_format == "json" ? "Copy JSON" : "Copy HTML")" />
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent Class="pt-0">
        <MudStack Spacing="4">
            <MudToggleGroup T="string" @bind-Value="_format" Size="Size.Small" Color="Color.Primary" Class="raw-format">
                <MudToggleItem Value="@("json")" Text="JSON" />
                <MudToggleItem Value="@("html")" Text="HTML" />
            </MudToggleGroup>

            <pre class="code-block">@(_format == "json" ? _json : _html)</pre>
        </MudStack>
    </MudCardContent>
</MudCard>

@code {
    private string _format = "json";
    private string _json = string.Empty;
    private string _html = string.Empty;

    [Parameter, EditorRequired]
    public PageMetadata Metadata { get; set; } = default!;

    protected override void OnParametersSet()
    {
        _json = JsonSerializer.Serialize(Metadata, IndentedJsonContext.Default.PageMetadata);
        _html = HtmlTagGenerator.Generate(Metadata);
    }
}

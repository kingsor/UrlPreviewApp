<MudCard Outlined Class="section-card">
    <MudCardHeader Class="pb-0">
        <CardHeaderContent>
            <MudText Typo="Typo.subtitle2" HtmlTag="h3">@Title</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent Class="pt-2">@ChildContent</MudCardContent>
</MudCard>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}

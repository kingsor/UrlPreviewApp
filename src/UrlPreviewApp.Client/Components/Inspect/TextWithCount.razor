@if (string.IsNullOrWhiteSpace(Text))
{
    <NotSet />
}
else
{
    <div>
        <div class="break-words">@Text</div>
        <MudText Typo="Typo.caption" HtmlTag="div" Color="@(Text.Length > Max ? Color.Warning : Color.Secondary)" Class="mt-1">
            @Text.Length / @Max chars
        </MudText>
    </div>
}

@code {
    [Parameter]
    public string? Text { get; set; }

    [Parameter, EditorRequired]
    public int Max { get; set; }
}

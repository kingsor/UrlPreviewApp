@if (!Found)
{
    <NotSet Text="Not found" />
}
else if (UrlNormalizer.IsHttpUrl(LinkUrl))
{
    <span class="link-value">
        <MudLink Href="@LinkUrl" Target="_blank" rel="noopener noreferrer" Color="Color.Success">Found</MudLink>
        <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Color="Color.Secondary" Style="font-size: 0.875rem" />
    </span>
}
else
{
    <MudText Inline Color="Color.Success">Found</MudText>
}

@code {
    [Parameter]
    public bool Found { get; set; }

    [Parameter]
    public string? LinkUrl { get; set; }
}

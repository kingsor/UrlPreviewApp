@implements IDisposable
@inject BrowserInterop Browser

@if (Label is null)
{
    <MudIconButton Icon="@(_copied ? Icons.Material.Filled.Check : Icons.Material.Outlined.ContentCopy)"
                   Color="@(_copied ? Color.Success : Color.Default)"
                   Size="Size.Small"
                   Class="@($"copy-button {(_copied ? "is-copied" : null)} {Class}")"
                   title="Copy"
                   aria-label="Copy"
                   OnClick="CopyAsync" />
}
else
{
    <MudButton Variant="Variant.Outlined"
               Size="Size.Small"
               Color="@(_copied ? Color.Success : Color.Default)"
               StartIcon="@(_copied ? Icons.Material.Filled.Check : Icons.Material.Outlined.ContentCopy)"
               Class="@Class"
               title="Copy"
               aria-label="@Label"
               OnClick="CopyAsync">
        @(_copied ? "Copied!" : Label)
    </MudButton>
}

@code {
    private bool _copied;
    private CancellationTokenSource? _reset;

    [Parameter, EditorRequired]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? Class { get; set; }

    private async Task CopyAsync()
    {
        if (!await Browser.CopyTextAsync(Text))
            return;

        _reset?.Cancel();
        _reset = new CancellationTokenSource();
        var token = _reset.Token;

        _copied = true;
        StateHasChanged();

        try
        {
            await Task.Delay(TimeSpan.FromSeconds(2), token);
            _copied = false;
        }
        catch (TaskCanceledException)
        {
            // A newer copy restarted the timer.
        }
    }

    public void Dispose() => _reset?.Cancel();
}

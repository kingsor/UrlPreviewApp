<div class="url-input">
    <form class="d-flex align-center gap-1" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
        <MudTextField @ref="_field"
                      T="string"
                      Value="Value"
                      ValueChanged="OnValueChanged"
                      Immediate
                      Variant="Variant.Text"
                      Placeholder="enter a url"
                      Disabled="Loading"
                      Error="@(!string.IsNullOrEmpty(Error))"
                      Class="flex-grow-1 mt-0"
                      InputMode="InputMode.url"
                      AutoFocus="false"
                      spellcheck="false"
                      autocomplete="off"
                      autocorrect="off"
                      autocapitalize="off"
                      aria-label="URL to preview" />

        @if (Loading)
        {
            <MudProgressCircular Indeterminate Size="Size.Small" Color="Color.Secondary" />
        }
        else if (!string.IsNullOrEmpty(Value))
        {
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" title="Clear (Esc)" aria-label="Clear" OnClick="OnClear" />
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" title="Refresh" aria-label="Refresh" OnClick="OnRefresh" />
        }
    </form>

    @if (!string.IsNullOrEmpty(Error))
    {
        <MudText Typo="Typo.body2" Color="Color.Error" Class="mt-2">@Error</MudText>
    }
</div>

@code {
    private MudTextField<string>? _field;

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<string> OnSubmit { get; set; }

    [Parameter]
    public EventCallback OnClear { get; set; }

    [Parameter]
    public EventCallback OnRefresh { get; set; }

    [Parameter]
    public bool Loading { get; set; }

    [Parameter]
    public string? Error { get; set; }

    public ValueTask FocusAsync() => _field?.FocusAsync() ?? ValueTask.CompletedTask;

    private Task OnValueChanged(string? value) => ValueChanged.InvokeAsync(value ?? string.Empty);

    private async Task SubmitAsync()
    {
        if (!string.IsNullOrWhiteSpace(Value))
            await OnSubmit.InvokeAsync(Value);
    }
}

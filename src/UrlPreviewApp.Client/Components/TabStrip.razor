@* Tab headers only: the caller renders the content of the active tab. *@
<MudTabs ActivePanelIndex="ActiveIndex"
         ActivePanelIndexChanged="SelectAsync"
         Elevation="0"
         Color="Color.Transparent"
         SliderColor="Color.Primary"
         Border
         Class="tabs"
         TabPanelsClass="d-none">
    @foreach (var item in Items)
    {
        <MudTabPanel @key="item.Key" Text="@item.Label" />
    }
</MudTabs>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<TabItem> Items { get; set; } = [];

    [Parameter]
    public string Active { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ActiveChanged { get; set; }

    private int ActiveIndex => Math.Max(0, Items.Select(i => i.Key).ToList().IndexOf(Active));

    private Task SelectAsync(int index)
    {
        if (index < 0 || index >= Items.Count)
            return Task.CompletedTask;

        var key = Items[index].Key;
        return key == Active ? Task.CompletedTask : ActiveChanged.InvokeAsync(key);
    }

    public sealed record TabItem(string Key, string Label);
}

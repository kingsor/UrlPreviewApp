@inherits LayoutComponentBase

<div class="shell">
    <header class="shell__bar">
        <div class="container shell__bar-inner">
            <a href="" class="shell__logo" aria-label="UrlPreviewApp home">
                <img src="icon.svg" alt="" width="48" height="48" />
            </a>
        </div>
    </header>

    <main class="container shell__main">
        @Body
    </main>

    <footer class="shell__bar">
        <div class="container shell__bar-inner shell__footer">
            <span class="eyebrow">@DateTime.UtcNow.Year © UrlPreviewApp</span>
            <span class="shell__credit">
                Based on <a href="https://github.com/KartikLabhshetwar/linkpreview" target="_blank" rel="noopener noreferrer">linkpreview</a> (MIT)
            </span>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@inherits LayoutComponentBase
@inject ThemePreferenceStore ThemePreference

<MudThemeProvider @ref="_themeProvider" Theme="AppTheme.Theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="shell">
    <MudAppBar Elevation="0">
        <MudContainer MaxWidth="MaxWidth.Medium" Class="d-flex align-center justify-space-between">
            <a href="" class="shell__logo" aria-label="UrlPreviewApp home">
                <img src="logo.png" alt="" width="40" height="40" class="@(_isDarkMode ? "shell__logo-img--dark" : null)" />
            </a>
            <div class="d-flex align-center">
                <MudTooltip Text="@(_isDarkMode ? "Switch to light theme" : "Switch to dark theme")">
                    <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)"
                                   Color="Color.Inherit"
                                   aria-label="Toggle light/dark theme"
                                   OnClick="ToggleThemeAsync" />
                </MudTooltip>
                <MudTooltip Text="Source code on GitHub">
                    <MudIconButton Icon="@Icons.Custom.Brands.GitHub"
                                   Color="Color.Inherit"
                                   Href="@RepositoryUrl"
                                   Target="_blank"
                                   Rel="noopener noreferrer"
                                   aria-label="UrlPreviewApp source code on GitHub (opens in a new tab)" />
                </MudTooltip>
            </div>
        </MudContainer>
    </MudAppBar>

    <MudMainContent Class="shell__main">
        <MudContainer MaxWidth="MaxWidth.Medium">
            @Body
        </MudContainer>
    </MudMainContent>

    <footer>
        <MudContainer MaxWidth="MaxWidth.Medium" Class="d-flex flex-wrap align-center justify-space-between gap-4 py-4">
            <span class="eyebrow eyebrow--as-written">
                @DateTime.UtcNow.Year © UrlPreviewApp
                <a href="@ReleaseUrl" target="_blank" rel="noopener noreferrer" class="footer__version" aria-label="Release notes for version @AppVersion.Current (opens in a new tab)">v@(AppVersion.Current)</a>
            </span>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Based on <MudLink Href="https://github.com/KartikLabhshetwar/linkpreview" Target="_blank" rel="noopener noreferrer" Color="Color.Inherit" Underline="Underline.Always">KartikLabhshetwar/linkpreview</MudLink> (MIT)
            </MudText>
        </MudContainer>
    </footer>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private const string RepositoryUrl = "https://github.com/kingsor/UrlPreviewApp";
    private static readonly string ReleaseUrl = $"{RepositoryUrl}/releases/tag/v{AppVersion.Current}";

    private MudThemeProvider? _themeProvider;

    // Light by default (also while prerendering); the user's stored choice is applied once interactive.
    private bool _isDarkMode;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _themeProvider is null)
            return;

        var isDarkMode = await ThemePreference.GetAsync() ?? false;
        if (isDarkMode != _isDarkMode)
        {
            _isDarkMode = isDarkMode;
            StateHasChanged();
        }
    }

    private async Task ToggleThemeAsync()
    {
        _isDarkMode = !_isDarkMode;
        await ThemePreference.SetAsync(_isDarkMode);
    }
}

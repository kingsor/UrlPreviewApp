<Project>

  <PropertyGroup>
    <!--
      false = reference the UrlPreviewParser NuGet package ($(UrlPreviewParserVersion)) (default, used by CI and Docker)
      true  = reference the UrlPreviewParser sources in ..\UrlPreviewParser (sibling repo)
    -->
    <UseLocalUrlPreviewParser Condition="'$(UseLocalUrlPreviewParser)' == ''">false</UseLocalUrlPreviewParser>
    <UrlPreviewParserVersion>1.1.0</UrlPreviewParserVersion>
    <UrlPreviewParserProject>$(MSBuildThisFileDirectory)..\UrlPreviewParser\src\UrlPreviewParser\UrlPreviewParser.csproj</UrlPreviewParserProject>
  </PropertyGroup>

</Project>
